{
  "mcpServers": {
    "morph": {
      "type": "http",
      "url": "https://api.morpheditor.com/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.morph_key}"
      },
      "headersHelper": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/device-header.sh\" || \"${CLAUDE_PLUGIN_ROOT}/scripts/device-header.cmd\""
    }
  }
}
