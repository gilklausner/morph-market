{
  "description": "Brings a style's components and research from the MORPH server when Claude gets the style, and removes them, and the session's passing work files, when the video is finished or the session closes; keeps a style's research out of the conversation; keeps the MORPH tools and sound up to date in the background; and points each session at the programs the MORPH tools bring.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_morph_morph__get_style",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run-node.sh",
              "${CLAUDE_PLUGIN_ROOT}/scripts/fetch-style-code.mjs"
            ],
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run-node.sh",
              "${CLAUDE_PLUGIN_ROOT}/scripts/remind.mjs",
              "tool"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run-node.sh",
              "${CLAUDE_PLUGIN_ROOT}/scripts/clear-style-code.mjs",
              "end"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/session-env.sh"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run-node.sh",
              "${CLAUDE_PLUGIN_ROOT}/scripts/clear-style-code.mjs",
              "start"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run-node.sh",
              "${CLAUDE_PLUGIN_ROOT}/scripts/update-tools.mjs",
              "start"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run-node.sh",
              "${CLAUDE_PLUGIN_ROOT}/scripts/guard-research.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run-node.sh",
              "${CLAUDE_PLUGIN_ROOT}/scripts/after-turn.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run-node.sh",
              "${CLAUDE_PLUGIN_ROOT}/scripts/remind.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run-node.sh",
              "${CLAUDE_PLUGIN_ROOT}/scripts/after-helper.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
