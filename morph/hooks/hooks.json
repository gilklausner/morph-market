{
  "description": "Brings a style's components from the MORPH server when Claude gets the style and removes them when the session closes, keeps the MORPH tools and sound up to date in the background, and points each session at the programs the MORPH tools bring.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_morph_morph__get_style",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run-node.sh",
              "${CLAUDE_PLUGIN_ROOT}/scripts/fetch-style-code.mjs"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run-node.sh",
              "${CLAUDE_PLUGIN_ROOT}/scripts/clear-style-code.mjs",
              "end"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/session-env.sh"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run-node.sh",
              "${CLAUDE_PLUGIN_ROOT}/scripts/clear-style-code.mjs",
              "start"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run-node.sh",
              "${CLAUDE_PLUGIN_ROOT}/scripts/update-tools.mjs",
              "start"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
